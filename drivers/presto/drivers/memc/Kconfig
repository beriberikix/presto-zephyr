config PIMORONI_RP2350_PSRAM
	bool "Pimoroni Presto APS6404 PSRAM (RP2350 QMI window 1)"
	default y
	depends on DT_HAS_PIMORONI_RP2350_PSRAM_ENABLED
	help
	  Bring up the 8 MB APS6404 PSRAM on QMI CS1 (GP47) at boot and map it
	  into XIP space at 0x11000000. Ported from the MIT-licensed MicroPython
	  rp2 PSRAM init. Tag the devicetree node with zephyr,memory-attr and
	  enable CONFIG_MEM_ATTR_HEAP to allocate from it.

if PIMORONI_RP2350_PSRAM

config PIMORONI_RP2350_PSRAM_INIT_PRIORITY
	int "PSRAM init priority"
	default 5
	help
	  POST_KERNEL init priority. Runs after clocks/GPIO are up (the QMI
	  bring-up needs clk_sys at final speed) and before the application
	  main(), so the mem-attr heap can allocate from PSRAM.

module = PIMORONI_RP2350_PSRAM
module-str = Pimoroni RP2350 PSRAM
source "subsys/logging/Kconfig.template.log_config"

endif # PIMORONI_RP2350_PSRAM
