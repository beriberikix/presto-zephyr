/*
 * SPDX-License-Identifier: MIT
 *
 * Enable the ST7701 panel (system display) and the CYW43439 radio together.
 * The framebuffer lives in PSRAM (see boards/presto_rp2350b_m33.conf), so the
 * display scanout and the Wi-Fi stack coexist in the freed SRAM.
 */

/ {
	chosen {
		zephyr,display = &st7701;
	};
};

&st7701 {
	status = "okay";
};

&airoc_wifi {
	status = "okay";
};
